<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <linearGradient id="blueGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1976D2" />
      <stop offset="100%" stop-color="#2196F3" />
    </linearGradient>
    
    <linearGradient id="orangeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF8A65" />
      <stop offset="100%" stop-color="#FF4B2B" />
    </linearGradient>

    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="15" flood-opacity="0.15"/>
    </filter>
  </defs>

  <circle cx="250" cy="250" r="250" fill="transparent"/>

  <path d="M 100 380 L 250 120 L 340 270 L 390 200 L 450 380 Z" fill="url(#blueGradient)" filter="url(#shadow)"/>
  
  <path d="M 50 300 C 150 350, 200 200, 300 250 C 400 300, 420 180, 450 150" fill="none" stroke="url(#orangeGradient)" stroke-width="28" stroke-linecap="round" stroke-linejoin="round" filter="url(#shadow)"/>

  <circle cx="450" cy="150" r="25" fill="#FF4B2B" filter="url(#shadow)"/>
  <circle cx="450" cy="150" r="10" fill="#FFFFFF"/>
</svg>
